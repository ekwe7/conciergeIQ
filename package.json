{
  "name": "concierge-iq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @conciergeiq/api dev",
    "lint": "eslint .",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs apps packages",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @conciergeiq/api db:generate",
    "db:migrate": "pnpm --filter @conciergeiq/api db:migrate",
    "db:seed": "pnpm --filter @conciergeiq/api db:seed",
    "test:architecture": "pnpm --filter @conciergeiq/api exec vitest run test/architecture",
    "test:e2e": "pnpm --filter @conciergeiq/api exec vitest run"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.4.0",
    "eslint": "^9.18.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2"
  },
  "packageManager": "pnpm@9.15.4"
}
