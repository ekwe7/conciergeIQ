{
  "name": "@conciergeiq/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=development src/shared/db/migrate.ts",
    "db:seed": "tsx --conditions=development db/seeds/dev.seed.ts"
  },
  "dependencies": {
    "@conciergeiq/contracts": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@fastify/websocket": "^10.0.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "fastify": "^4.28.1",
    "pdfkit": "^0.15.1",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.13.5",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.28.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^5.0.4"
  }
}
