# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
POSTGRES_USER=concierge
POSTGRES_PASSWORD=concierge_secret
POSTGRES_DB=concierge_iq
DATABASE_URL=postgresql://concierge:concierge_secret@localhost:5432/concierge_iq

# Staff sign-in. Use a long random value, for example: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Missed-order alerts (Termii SMS / WhatsApp). Leave TERMII_API_KEY empty to only log alerts.
# TERMII_BASE_URL is shown in your Termii dashboard; TERMII_SENDER_ID must be approved by Termii.
TERMII_API_KEY=
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_SENDER_ID=ConciergeIQ
# dnd reaches numbers on Do-Not-Disturb (most Nigerian lines); generic does not.
TERMII_SMS_CHANNEL=dnd
ESCALATION_SWEEP_SECONDS=15

# Redis (Stage 2)
REDIS_URL=redis://localhost:6379

# Client URLs / CORS. GUEST_APP_URL is printed inside every room's QR code.
GUEST_APP_URL=http://localhost:5173
DASHBOARD_APP_URL=http://localhost:5174
